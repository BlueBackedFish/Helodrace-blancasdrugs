<?xml version="1.0" encoding="utf-8"?>
<Defs>


    <!--소나타-->
    <HediffDef>
        <defName>SonataHigh</defName>
        <hediffClass>Hediff_High</hediffClass>
        <label>sonata sedation</label>
        <labelNoun>sedated by sonata</labelNoun>
        <description>The nervous system is moderately suppressed by Sonata. Although this hangover lasts for a brief 8-hour window, the short-acting nature of the drug temporary forces a slightly heavier dampening of consciousness, manipulation, moving, and sight compared to alternative sedatives. While a faint, sluggish calmness stabilizes the mind, coordinating crisp movements is temporarily difficult.</description>
        <descriptionHyperlinks>
            <ThingDef>Sonata</ThingDef>
        </descriptionHyperlinks>
        <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-3.0</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
        </comps>
        <stages>
            <li>
                <label>drowsy</label>
                <painFactor>0.7</painFactor>
                <socialFightChanceFactor>0.5</socialFightChanceFactor>
                <hungerRateFactorOffset>-0.5</hungerRateFactorOffset>
                <statFactors>
                    <RestFallRateFactor>1.3</RestFallRateFactor>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.6</postFactor>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>-0.20</offset>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>-0.20</offset>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>-0.20</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <!--소나타
    수면제 효과-->

    <HediffDef>
        <defName>SonataSleep</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>Sonata logic trigger</label>
        <description></description>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>0.0</severityPerDay>
                <showHoursToRecover>false</showHoursToRecover>
            </li>
            <li Class="HelodBlancasDrug.HediffCompProperties_CompareSetNeedAndRemove">
                <hediffA>Somnifacientstronghold</hediffA>
                <offsetA>0.11</offsetA>
                <hediffB>Amphetaminesstronghold</hediffB>
                <offsetB>0.0</offsetB>
                <need>Rest</need>
                <targetValue>0.0</targetValue>
            </li>
            <li Class="HelodBlancasDrug.HediffCompProperties_CompareGiveHediffAndRemove">
                <hediffA>Somnifacientstronghold</hediffA>
                <offsetA>0.11</offsetA>
                <hediffB>Amphetaminesstronghold</hediffB>
                <offsetB>0.0</offsetB>
                <hediffToGive>SonataDeepSleeper</hediffToGive>
                <severityToGive>1.0</severityToGive>
            </li>
        </comps>
        <stages>
            <li><visible>false</visible></li>
        </stages>
    </HediffDef>


    <!--소나타
    깊은잠 부여자-->

    <HediffDef>
        <defName>SonataDeepSleeper</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>deep sleeper (sonata)</label>
        <labelNoun>a deep sleeper</labelNoun>
        <description>The sedative compound of Sonata has successfully suppressed the minor active stimulants, meeting the criteria for deep sleep. When the pawn rests, they will transition into the restorative deep sleep phase. Due to Sonata's weak sedative factor, this state will fail to trigger if any significant stimulants remain in the system.</description>
        <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-2.0</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
            <li Class="HelodBlancasDrug.HediffCompProperties_SleepLogic">
                <hediffToGive>DeepSleep</hediffToGive>
            </li>
        </comps>
        <stages>
            <li>
                <label>sleep-ready</label>
            </li>
        </stages>
    </HediffDef>


    <!--엠비엔-->

    <HediffDef>
        <defName>AmbienHigh</defName>
        <hediffClass>Hediff_High</hediffClass>
        <label>ambien sedation</label>
        <labelNoun>sedated by ambien</labelNoun>
        <description>The nervous system is moderately suppressed by Ambien. Throughout this 12-hour hangover window, consciousness, manipulation, moving, and sight are noticeably reduced, though the physical deficits are relatively mild compared to stronger sedatives. It induces a comfortable, placid mindset that buffers stress, while altering sleep and hunger depletion rates to slow down overall bodily activity.</description>
        <descriptionHyperlinks>
            <ThingDef>Ambien</ThingDef>
        </descriptionHyperlinks>
        <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-2.0</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>

        </comps>
        <stages>
            <li>
                <label>sedated</label>
                <painFactor>0.8</painFactor>
                <socialFightChanceFactor>0.5</socialFightChanceFactor>
                <hungerRateFactorOffset>-0.5</hungerRateFactorOffset>
                <statFactors>
                    <RestFallRateFactor>1.3</RestFallRateFactor>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.7</postFactor>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>-0.10</offset>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>-0.10</offset>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>-0.20</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>


    <!--엠비엔
    깊은잠 부여자-->

    <HediffDef>
        <defName>AmbienDeepSleeper</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>deep sleeper (ambien)</label>
        <labelNoun>a deep sleeper</labelNoun>
        <description>The sedative properties of Ambien have successfully overwhelmed the active body stimulants, satisfying the conditions for deep sleep. When a pawn with this status rests in a bed or sleeping spot, they will smoothly transition into the restorative deep sleep phase. If the pawn's stimulation was too high, this state will fail to trigger.</description>
        <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-2.0</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
            <li Class="HelodBlancasDrug.HediffCompProperties_SleepLogic">
                <hediffToGive>DeepSleep</hediffToGive>
            </li>
        </comps>
        <stages>
            <li>
                <label>sleep-ready</label>
            </li>
        </stages>
    </HediffDef>

