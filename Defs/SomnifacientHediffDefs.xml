                <offsetB>0.0</offsetB>
                <hediffToGive>BD_RestorilDeepSleeper</hediffToGive>
                <severityToGive>1.0</severityToGive>
            </li>

        </comps>
        <stages>
            <li />
        </stages>
    </HediffDef>

    

