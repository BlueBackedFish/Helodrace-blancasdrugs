<?xml version="1.0" encoding="utf-8"?>
<Defs>


    
    <HediffDef>
        <defName>BD_SonataHigh</defName>
        <hediffClass>Hediff_High</hediffClass>
        <label>sonata sedation</label>
        <labelNoun>sedated by sonata</labelNoun>
        <description>The nervous system is moderately suppressed by Sonata. Although this hangover lasts for a brief 8-hour window, the short-acting nature of the drug temporary forces a slightly heavier dampening of consciousness, manipulation, moving, and sight compared to alternative sedatives. While a faint, sluggish calmness stabilizes the mind, coordinating crisp movements is temporarily difficult.</description>
        <descriptionHyperlinks>
            <ThingDef>BD_Sonata</ThingDef>
        </descriptionHyperlinks>
        <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-3.0</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
        </comps>
        <stages>
            <li>
                <label>drowsy</label>
                <painFactor>0.7</painFactor>
                <socialFightChanceFactor>0.5</socialFightChanceFactor>
                <hungerRateFactorOffset>-0.5</hungerRateFactorOffset>
                <statFactors>
                    <RestFallRateFactor>1.3</RestFallRateFactor>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.6</postFactor>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>-0.20</offset>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>-0.20</offset>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>-0.20</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    

