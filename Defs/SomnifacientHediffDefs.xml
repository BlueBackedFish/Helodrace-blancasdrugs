    <HediffDef>
        <defName>BD_SonataDeepSleeper</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>deep sleeper (sonata)</label>
        <labelNoun>a deep sleeper</labelNoun>
        <description>The sedative compound of Sonata has successfully suppressed the minor active stimulants, meeting the criteria for deep sleep. When the pawn rests, they will transition into the restorative deep sleep phase. Due to Sonata's weak sedative factor, this state will fail to trigger if any significant stimulants remain in the system.</description>
        <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-2.0</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
            <li Class="HelodBlancasDrug.HediffCompProperties_SleepLogic">
                <hediffToGive>BD_DeepSleep</hediffToGive>
            </li>
        </comps>
        <stages>
            <li>
                <label>sleep-ready</label>
            </li>
        </stages>
    </HediffDef>


    

    <HediffDef>
