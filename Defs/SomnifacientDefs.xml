<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--엠비엔
	띵 정의-->
    <ThingDef ParentName="BlancasDrugBase">
        <defName>Ambien</defName>
        <label>ambien</label>
        <description>A fast-acting non-benzodiazepine (Z-drug) sedative designed for rapid sleep induction. Upon ingestion, it introduces a sedative factor of 2 to promptly quiet the nervous system. Compared to heavy benzodiazepines, its hangover duration is limited to just 12 hours, allowing a much faster return to daily routines.\nWhile providing a cozy, moderate mood boost upon use, the sedative factor must still outweigh the pawn's active stimulant factors to successfully trigger the deep sleep sequence.</description>
        <category>Item</category>

        <descriptionHyperlinks>
            <HediffDef>AmbienHigh</HediffDef>
            <HediffDef>ZDrugsTolerance</HediffDef>
            <HediffDef>ZDrugsAddiction</HediffDef>
        </descriptionHyperlinks>

        <thingClass>ThingWithComps</thingClass>
        <comps>
            <li Class="CompProperties_Drug">
                <chemical>ZDrugs</chemical>
                <addictiveness>0.1</addictiveness>
                <minToleranceToAddict>0.80</minToleranceToAddict>
                <existingAddictionSeverityOffset>0.1</existingAddictionSeverityOffset>
            </li>
        </comps>

        <costList>
            <Neutroamine>2</Neutroamine>
        </costList>

        <recipeMaker>
            <recipeUsers>
                <li>DrugLab</li>
            </recipeUsers>
            <researchPrerequisite>HelodBlancaAdvancedSomnifacients</researchPrerequisite>
        </recipeMaker>

        <graphicData>
            <texPath>Things/Item/Drug/Ambien</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <rotatable>false</rotatable>

        <statBases>
            <WorkToMake>500</WorkToMake>
            <MarketValue>30</MarketValue>
            <Mass>0.1</Mass>
        </statBases>
        <techLevel>Industrial</techLevel>


        <ingestible>
            <joyKind>Chemical</joyKind>
            <joy>0.001</joy>
            <drugCategory>Medical</drugCategory>
            <foodType>Processed</foodType>
            <baseIngestTicks>100</baseIngestTicks>
            <ingestHoldOffsetStanding>
                <northDefault>
                    <offset>(0.18,0,0)</offset>
                </northDefault>
            </ingestHoldOffsetStanding>
            <ingestCommandString>Take {0}</ingestCommandString>
            <ingestReportString>Taking {0}.</ingestReportString>
            <useEatingSpeedStat>false</useEatingSpeedStat>
            <chairSearchRadius>0</chairSearchRadius>
            <outcomeDoers>
                <li Class="IngestionOutcomeDoer_GiveHediff">
                    <hediffDef>AmbienHigh</hediffDef>
                    <severity>1.0</severity>
                </li>

                <li Class="IngestionOutcomeDoer_GiveHediff">
                    <hediffDef>AmbienSleep</hediffDef>
                    <severity>1.0</severity>
                </li>

                <li Class="IngestionOutcomeDoer_GiveHediff">
                    <hediffDef>Somnifacientstronghold</hediffDef>
                    <severity>0.2</severity>
                </li>

                <li Class="IngestionOutcomeDoer_GiveHediff">
                    <hediffDef>ZDrugsTolerance</hediffDef>
                    <severity>0.1</severity>
                    <divideByBodySize>true</divideByBodySize>
                    <multiplyByGeneToleranceFactors>true</multiplyByGeneToleranceFactors>
                </li>
            </outcomeDoers>
        </ingestible>
    </ThingDef>

