    <ThingDef ParentName="BlancasDrugBase">
        <defName>Restoril</defName>
        <label>restoril</label>
        <description>A potent benzodiazepine-based sedative and sleep inducer. Upon ingestion, it introduces a sedative factor of 4 to forcefully suppress the central nervous system. While highly effective at calming jittery nerves and forcing a pawn to bed, it leaves behind a heavy, lingering 'hangover' effect that persists for a full 24 hours. As it possesses the longest hangover duration among all sedatives, a pawn will remain severely impaired for a whole day.\nThe sleep-inducing mechanism triggers successfully only when the sedative factor outweighs the pawn's current Amphetamine Factor; if the pawn is too heavily stimulated, the drug may fail to bring about proper sleep.</description>
        <category>Item</category>

        <descriptionHyperlinks>
            <HediffDef>RestorilHigh</HediffDef>
            <HediffDef>BenzodiazepinesTolerance</HediffDef>
            <HediffDef>BenzodiazepinesAddiction</HediffDef>
        </descriptionHyperlinks>

        <thingClass>ThingWithComps</thingClass>
        <comps>
            <li Class="CompProperties_Drug">
                <chemical>Benzodiazepines</chemical>
                <addictiveness>0.15</addictiveness>
                <minToleranceToAddict>0.80</minToleranceToAddict>
                <existingAddictionSeverityOffset>0.15</existingAddictionSeverityOffset>
            </li>
        </comps>

        <costList>
            <Neutroamine>3</Neutroamine>
        </costList>

        <recipeMaker>
            <recipeUsers>
                <li>DrugLab</li>
            </recipeUsers>
