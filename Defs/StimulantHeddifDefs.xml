    <HediffDef>
        <defName>BD_StimulantStronghold</defName>
        <label>stimulant accumulation</label>
        <maxSeverity>1.0</maxSeverity>
        <description>Represents the accumulated Stimulant Factor and the level of overload on the central nervous system. Consecutive ingestion drives this value higher; the moment it breaches 6.5, the pawn enters a critical overdose state, risking fatal heart attacks or permanent brain damage.\nFurthermore, to suppress this intense hyper-arousal and offset the impending crash, the pawn must accumulate a sedative factor equal to or higher than this current accumulation value for any sleeping aids to take effect.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.001</severityPerDay>
                <showDaysToRecover>true</showDaysToRecover>
            </li>
        </comps>
        <stages>
            <li>
                <label>safe</label>
            </li>

            <li>
                <label>overdose</label>
                <minSeverity>0.65</minSeverity>
                <painFactor>0.5</painFactor>

                <hediffGivers>
                    <li Class="HediffGiver_Random">
                        <hediff>ChemicalDamageModerate</hediff>
                        <mtbDays>5</mtbDays>
                        <partsToAffect>
                            <li>Brain</li>
                        </partsToAffect>
                    </li>
                    <li Class="HediffGiver_Random">
                        <hediff>HeartAttack</hediff>
                        <mtbDays>80</mtbDays>
                        <partsToAffect>
                            <li>Heart</li>
