    <HediffDef ParentName="DrugToleranceBase">
        <defName>AmphetaminesTolerance</defName>
        <label>amphetamines tolerance</label>
        <description>The body's adaptation to continuous exposure to amphetamines. Higher tolerance reduces the efficiency and duration of the stimulant effects, driving the pawn to consume larger doses to achieve the same high, which drastically increases the risk of an overdose.</description>
        <descriptionHyperlinks>
            <ThingDef>Desoxyn</ThingDef>
            <ThingDef>Benzedrine</ThingDef>
            <ThingDef>Dexedrine</ThingDef>
        </descriptionHyperlinks>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.015</severityPerDay>
            </li>
            <li Class="HediffCompProperties_DrugEffectFactor">
                <chemical>Amphetamines</chemical>
            </li>
        </comps>
        <hediffGivers>
            <li Class="HediffGiver_RandomDrugEffect">
                <hediff>ChemicalDamageModerate</hediff>
                <severityToMtbDaysCurve>
                    <points>
                        <li>(0.45, 99999)</li>
                        <li>(0.5, 120)</li>
                        <li>(1, 90)</li>
                    </points>
                </severityToMtbDaysCurve>
                <partsToAffect>
                    <li>Brain</li>
                </partsToAffect>
            </li>
        </hediffGivers>
    </HediffDef>

    <!--=======================중독=================-->

    <HediffDef ParentName="AddictionBase">
        <defName>AmphetaminesAddiction</defName>
        <label>amphetamines addiction</label>
        <description>A state where the body's chemical balance is entirely dominated by amphetamines. Without regular doses, the dopamine system collapses completely, inducing severe depression, diminished physical capacities, and intense withdrawal symptoms.</description>
        <descriptionHyperlinks>
            <ThingDef>Desoxyn</ThingDef>
            <ThingDef>Benzedrine</ThingDef>
            <ThingDef>Dexedrine</ThingDef>
        </descriptionHyperlinks>
        <hediffClass>Hediff_Addiction</hediffClass>
        <chemicalNeed>Chemical_Amphetamines</chemicalNeed>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.045</severityPerDay>
                <showDaysToRecover>true</showDaysToRecover>
            </li>
        </comps>
        <stages>
            <li />
            <li>
                <label>withdrawal</label>
                <painFactor>3</painFactor>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>-0.30</offset>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>-0.50</offset>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>-0.20</offset>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>-0.10</offset>
                    </li>
                </capMods>
                <mentalStateGivers>
                    <li>
                        <mentalState>Binging_DrugExtreme</mentalState>
                        <mtbDays>40</mtbDays>
                    </li>
                    <li>
                        <mentalState>Wander_Psychotic</mentalState>
                        <mtbDays>10</mtbDays>
                    </li>
                </mentalStateGivers>
            </li>
        </stages>
    </HediffDef>

    <!--회복-->

    <HediffDef ParentName="AddictionBase">
        <defName>AmphetaminesRecovery</defName>
        <label>amphetamines Recovery</label>
        <description>The neural system is finally stabilizing after enduring the devastating crash of amphetamines. While the acute side effects have subsided, the overstimulated brain and body are undergoing a readjustment period to restore their natural chemical balance. Once this phase concludes, the accumulated amphetamine factor will be fully reset.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <maxSeverity>1.0</maxSeverity>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-2.0</severityPerDay>
                <showDaysToRecover>true</showDaysToRecover>
            </li>
        </comps>
        <stages>
        </stages>
    </HediffDef>

    <!--교차복용-->

    <HediffDef>
        <defName>Amphetaminesstronghold</defName>
        <label>amphetamines accumulation</label>
        <maxSeverity>1.0</maxSeverity>
        <description>Represents the accumulated Amphetamine Factor and the level of overload on the central nervous system. Consecutive ingestion drives this value higher; the moment it breaches 6.5, the pawn enters a critical overdose state, risking fatal heart attacks or permanent brain damage.\nFurthermore, to suppress this intense hyper-arousal and offset the impending crash, the pawn must accumulate a sedative factor equal to or higher than this current accumulation value for any sleeping aids to take effect.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.001</severityPerDay>
                <showDaysToRecover>true</showDaysToRecover>
            </li>
        </comps>
        <stages>
            <li>
                <label>safe</label>
            </li>

            <li>
                <label>overdose</label>
                <minSeverity>0.65</minSeverity>
                <painFactor>0.5</painFactor>

                <hediffGivers>
                    <li Class="HediffGiver_Random">
                        <hediff>ChemicalDamageModerate</hediff>
                        <mtbDays>5</mtbDays>
                        <partsToAffect>
                            <li>Brain</li>
                        </partsToAffect>
                    </li>
                    <li Class="HediffGiver_Random">
                        <hediff>HeartAttack</hediff>
                        <mtbDays>80</mtbDays>
                        <partsToAffect>
                            <li>Heart</li>
                        </partsToAffect>
                    </li>
                </hediffGivers>
            </li>
        </stages>
    </HediffDef>

