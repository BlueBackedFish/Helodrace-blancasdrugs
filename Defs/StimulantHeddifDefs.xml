    <HediffDef ParentName="DrugToleranceBase">
        <defName>BD_AmphetaminesTolerance</defName>
        <label>amphetamines tolerance</label>
        <description>The body's adaptation to continuous exposure to amphetamines. Higher tolerance reduces the efficiency and duration of the stimulant effects, driving the pawn to consume larger doses to achieve the same high, which drastically increases the risk of an overdose.</description>
        <descriptionHyperlinks>
            <ThingDef>BD_Desoxyn</ThingDef>
            <ThingDef>BD_Benzedrine</ThingDef>
            <ThingDef>BD_Dexedrine</ThingDef>
        </descriptionHyperlinks>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.015</severityPerDay>
            </li>
            <li Class="HediffCompProperties_DrugEffectFactor">
                <chemical>BD_Amphetamines</chemical>
            </li>
        </comps>
        <hediffGivers>
            <li Class="HediffGiver_RandomDrugEffect">
                <hediff>ChemicalDamageModerate</hediff>
                <severityToMtbDaysCurve>
                    <points>
                        <li>(0.45, 99999)</li>
                        <li>(0.5, 120)</li>
                        <li>(1, 90)</li>
                    </points>
                </severityToMtbDaysCurve>
                <partsToAffect>
                    <li>Brain</li>
                </partsToAffect>
            </li>
        </hediffGivers>
    </HediffDef>

    <HediffDef ParentName="DrugToleranceBase">
        <defName>BD_CocaineTolerance</defName>
        <label>cocaine tolerance</label>
        <description>The body's adaptation to repeated cocaine exposure. Higher tolerance blunts the rush from cocaine cola and shortens its useful stimulant window, pushing the pawn toward more frequent dosing and increasing the risk of developing cocaine dependence.</description>
        <descriptionHyperlinks>
            <ThingDef>BD_CocaineCola</ThingDef>
        </descriptionHyperlinks>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.02</severityPerDay>
            </li>
            <li Class="HediffCompProperties_DrugEffectFactor">
                <chemical>BD_Cocaine</chemical>
            </li>
        </comps>
        <hediffGivers>
            <li Class="HediffGiver_RandomDrugEffect">
                <hediff>ChemicalDamageModerate</hediff>
                <severityToMtbDaysCurve>
                    <points>
                        <li>(0.45, 99999)</li>
