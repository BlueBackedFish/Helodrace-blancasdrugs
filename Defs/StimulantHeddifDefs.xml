    <HediffDef>
        <defName>BD_DesoxynHigh</defName>
        <hediffClass>Hediff_High</hediffClass>
        <label>Desoxyn effect</label>
        <labelNoun>a Desoxyn effect</labelNoun>
        <description>Desoxyn is active within the system. Initially, it hyper-stimulates the central nervous system, drastically enhancing consciousness, motor functions, and turning off fatigue and pain. However, once the stimulation wears off, the depletion of neurotransmitters plunges the pawn into a devastating 'Crash' state characterized by extreme lethargy, vomiting, and mental volatility. The body and mind remain highly unstable until fully recovered.</description>
        <descriptionHyperlinks>
            <ThingDef>BD_Desoxyn</ThingDef>
        </descriptionHyperlinks>
        <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
        <scenarioCanAdd>true</scenarioCanAdd>
        <maxSeverity>1.0</maxSeverity>
        <isBad>false</isBad>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.25</severityPerDay>
                <showHoursToRecover>true</showHoursToRecover>
            </li>
            <li Class="HelodBlancasDrug.HediffCompProperties_OnRemoval">
                <hediffToGive>BD_AmphetaminesRecovery</hediffToGive>
                <hediffsToRemove>
                    <li>BD_StimulantStronghold</li>
                </hediffsToRemove>
            </li>
            <li Class="HelodBlancasDrug.HediffCompProperties_ExclusiveGroup">
                <groupName>AmphetamineHigh</groupName>
                <stageStrengths>
                    <li>0</li> <!-- crash -->
                    <li>5</li> <!-- high -->
                </stageStrengths>
            </li>
            <li Class="HediffCompProperties_RemoveIfOtherHediff">
                <hediffs>
                    <li>BD_DeepSleep</li>
                </hediffs>
                <stages>0</stages>
                <mtbHours>0.1</mtbHours>
            </li>
        </comps>
        <stages>

            <!--?곗슱??-->
            <li>
                <label>crash</label>
                <painFactor>1.5</painFactor>
                <vomitMtbDays>0.75</vomitMtbDays>
                <socialFightChanceFactor>5</socialFightChanceFactor>
                <hungerRateFactorOffset>1.0</hungerRateFactorOffset>
                <statOffsets>
                    <RestFallRateFactor>4.0</RestFallRateFactor>
                    <MentalBreakThreshold>0.4</MentalBreakThreshold>
                </statOffsets>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>-0.30</offset>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>-0.20</offset>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>-0.20</offset>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>-0.20</offset>
                    </li>
                </capMods>
            </li>

            <!--?대???
            high???곹깭?뽰븘?-->
            <li>
                <label>high</label>
                <minSeverity>0.4</minSeverity>
                <painFactor>0.5</painFactor>
                <socialFightChanceFactor>1.5</socialFightChanceFactor>
                <hungerRateFactorOffset>-0.7</hungerRateFactorOffset>
                <statFactors>
                    <RestFallRateFactor>0.1</RestFallRateFactor>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>0.10</offset>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <offset>0.20</offset>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.20</offset>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>0.10</offset>
                    </li>
                </capMods>
            </li>
